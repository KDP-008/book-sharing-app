    <diagram name="Technology Stack" id="TECH-STACK">
        <mxGraphModel dx="736" dy="622" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="tech-common" value="&lt;h3&gt;Common Tech Stack (for most services)&lt;/h3&gt;&lt;ul style=&quot;text-align: left;&quot;&gt;&lt;li&gt;&lt;b&gt;Language/Framework&lt;/b&gt;: Java 21, Spring Boot 3&lt;/li&gt;&lt;li&gt;&lt;b&gt;Build Tool&lt;/b&gt;: Maven / Gradle&lt;/li&gt;&lt;li&gt;&lt;b&gt;Containerization&lt;/b&gt;: Docker&lt;/li&gt;&lt;li&gt;&lt;b&gt;Orchestration&lt;/b&gt;: Kubernetes (Amazon EKS)&lt;/li&gt;&lt;li&gt;&lt;b&gt;API Gateway&lt;/b&gt;: Spring Cloud Gateway or Amazon API Gateway&lt;/li&gt;&lt;li&gt;&lt;b&gt;Service Discovery&lt;/b&gt;: Kubernetes DNS / Spring Cloud Kubernetes&lt;/li&gt;&lt;li&gt;&lt;b&gt;Distributed Tracing&lt;/b&gt;: OpenTelemetry with AWS X-Ray&lt;/li&gt;&lt;li&gt;&lt;b&gt;Logging/Monitoring&lt;/b&gt;: ELK Stack or Amazon CloudWatch&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="40" width="480" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="tech-user" value="&lt;h3&gt;1. User Service&lt;/h3&gt;&lt;ul style=&quot;text-align: left;&quot;&gt;&lt;li&gt;&lt;b&gt;Responsibilities&lt;/b&gt;: User registration, authentication (JWT), profile management.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Database&lt;/b&gt;: Amazon RDS for PostgreSQL/MySQL.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Caching&lt;/b&gt;: Amazon ElastiCache for Redis.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="340" width="480" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="tech-book" value="&lt;h3&gt;2. Book Catalog Service&lt;/h3&gt;&lt;ul style=&quot;text-align: left;&quot;&gt;&lt;li&gt;&lt;b&gt;Responsibilities&lt;/b&gt;: CRUD for books, searching, browsing, managing book metadata and cover images.&lt;/li&gt;&lt;li&gt;&lt;b_gt;Database&lt;/b_gt;: Amazon RDS for PostgreSQL/MySQL.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Search&lt;/b&gt;: Amazon OpenSearch Service.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Object Storage&lt;/b&gt;: Amazon S3.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Caching&lt;/b&gt;: Amazon ElastiCache for Redis.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="500" width="480" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="tech-lending" value="&lt;h3&gt;3. Lending Service&lt;/h3&gt;&lt;ul style=&quot;text-align: left;&quot;&gt;&lt;li&gt;&lt;b&gt;Responsibilities&lt;/b&gt;: Manages book requests, approvals/denials, and tracks the state of borrowed/lent books.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Database&lt;/b&gt;: Amazon RDS for PostgreSQL/MySQL.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Asynchronous Communication&lt;/b&gt;: Publishes events to Amazon SQS.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;align=left;" parent="1" vertex="1">
                    <mxGeometry x="560" y="40" width="480" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="tech-notif" value="&lt;h3&gt;4. Notification Service&lt;/h3&gt;&lt;ul style=&quot;text-align: left;&quot;&gt;&lt;li&gt;&lt;b&gt;Responsibilities&lt;/b&gt;: Listens for events and sends notifications to users.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Messaging&lt;/b&gt;: Consumes messages from an Amazon SQS queue.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Notifications&lt;/b&gt;: Uses Amazon SNS to send emails, SMS, or push notifications.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;align=left;" parent="1" vertex="1">
                    <mxGeometry x="560" y="220" width="480" height="160" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>